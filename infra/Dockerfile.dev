# LifeSpire local dev with hot reload.
# The repo is bind-mounted at /app; `pnpm install` runs inside the container
# (native modules like argon2 are compiled here with python3/make/g++).
# Code changes apply live: Nest `--watch` for the API, Vite HMR for the web.
# Dev-only image: never use for production (see apps/api/Dockerfile).
FROM node:24-alpine
RUN apk add --no-cache python3 make g++ && corepack enable
WORKDIR /app
# pnpm store lives on a named volume (see compose) to survive restarts.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
CMD ["sh", "-c", "pnpm install --frozen-lockfile"]
