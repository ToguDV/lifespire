{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    // Emit a plain CJS tree for NestJS (CommonJS). Vite/Vitest keep consuming
    // the TS sources via the `import` export condition; no new tooling needed.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src",
    "composite": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/fixtures"]
}
