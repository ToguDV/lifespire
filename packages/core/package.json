{
  "name": "@lifespire/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/cjs/index.js",
      "default": "./src/index.ts"
    },
    "./domain/*": {
      "import": "./src/domain/*.ts",
      "require": "./dist/cjs/domain/*.js",
      "default": "./src/domain/*.ts"
    },
    "./content/*": {
      "import": "./src/content/*.ts",
      "require": "./dist/cjs/content/*.js",
      "default": "./src/content/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
