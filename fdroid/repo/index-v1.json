{"repo": {"timestamp": 1793888099000, "version": 20002, "name": "LifeSpire", "icon": "icon.png", "address": "https://togudv.github.io/lifespire/fdroid/repo", "description": "This is a repository of apps to be used with F-Droid. Applications in this repository are either official binaries built by the original application developers, or are binaries built from source by the admin of f-droid.org using the tools on https://gitlab.com/fdroid."}, "requests": {"install": [], "uninstall": []}, "apps": [{"allowedAPKSigningKeys": ["209d9fd8e940df5a8bcdcc6f04ace0332ada901050559ef8e5b4bab5703e4c22"], "authorName": "ToguDV", "categories": ["Sports & Health"], "suggestedVersionCode": "4002", "description": "LifeSpire turns your quests and trials into a daily encounter map. Pick a few\nweekly vows, resolve the encounters that match your day, and close the journey\nwhen the week ends.\n\nThe app is local-first: saves stay on the device, nearby sync happens directly\nover the local network between Android and desktop, and there is no account,\ncloud copy or telemetry.\n", "issueTracker": "https://github.com/ToguDV/lifespire/issues", "license": "MIT", "sourceCode": "https://github.com/ToguDV/lifespire", "summary": "A quiet ascent through your quests", "webSite": "https://github.com/ToguDV/lifespire", "added": 1793825501000, "packageName": "com.lifespire.app", "lastUpdated": 1793888099000, "localized": {"en-US": {"name": "LifeSpire"}}}], "packages": {"com.lifespire.app": [{"added": 1793888099000, "apkName": "com.lifespire.app_4002.apk", "hash": "2c6cfe549cf5b64febc520976e7d88350d836a5b068edbde731301420f5d2bc8", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a", "armeabi-v7a"], "packageName": "com.lifespire.app", "sig": "717de5cbdcf11cdac659295e011fdbd7", "signer": "209d9fd8e940df5a8bcdcc6f04ace0332ada901050559ef8e5b4bab5703e4c22", "size": 54760909, "targetSdkVersion": 36, "uses-permission": [["android.permission.CAMERA", null], ["android.permission.INTERNET", null