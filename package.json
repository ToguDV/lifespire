{
  "name": "lifespire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A productivity roguelike: turn real-life tasks into a daily dungeon run.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@lifespire/config": "workspace:*",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9"
  }
}
