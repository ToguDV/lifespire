{
  "name": "lifespire-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @lifespire/web dev",
    "dev:api": "pnpm --filter @lifespire/api start:dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @lifespire/web build",
    "build:api": "pnpm --filter @lifespire/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "typecheck:e2e": "pnpm --filter @lifespire/web typecheck:e2e",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @lifespire/web test",
    "test:api": "pnpm --filter @lifespire/api test",
    "test:e2e": "pnpm --filter @lifespire/web test:e2e",
    "preview": "pnpm --filter @lifespire/web preview"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1"
}
