{
  "name": "lifespire-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @lifespire/web dev",
    "dev:api": "pnpm --filter @lifespire/api start:dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @lifespire/web build",
    "build:api": "pnpm --filter @lifespire/api build",
    "build:desktop": "pnpm --filter @lifespire/desktop build",
    "package:desktop": "pnpm --filter @lifespire/desktop package",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "typecheck:e2e": "pnpm --filter @lifespire/web typecheck:e2e",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @lifespire/web test",
    "test:api": "pnpm --filter @lifespire/api test",
    "test:e2e": "pnpm --filter @lifespire/web test:e2e",
    "preview": "pnpm --filter @lifespire/web preview",
    "dev:mobile": "pnpm --filter @lifespire/mobile start",
    "build:mobile": "pnpm --filter @lifespire/mobile build",
    "test:mobile": "pnpm --filter @lifespire/mobile test",
    "dev:desktop": "pnpm --filter @lifespire/desktop dev"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.10",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1"
}
