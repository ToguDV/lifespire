# ---- LifeSpire API ----
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://lifespire:CHANGE_ME@postgres:5432/lifespire

# 32+ chars, generated with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_ISSUER=lifespire
JWT_AUDIENCE=lifespire-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 32+ chars, separate from JWT_SECRET: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

CORS_ORIGINS=https://app.example.com
PUBLIC_WEB_URL=https://app.example.com
ALLOW_PUBLIC_URL_FALLBACK=false
MAX_DOCUMENT_BYTES=524288
MAX_REQUEST_BYTES=1048576
# Long-poll change feed; keep it below the desktop proxy's 35 s timeout.
SYNC_WATCH_TIMEOUT_MS=25000
LOG_LEVEL=info

# ---- Postgres ----
POSTGRES_USER=lifespire
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lifespire
