generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TokenType {
  INVITE
  PASSWORD_RESET
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  activatedAt     DateTime?
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  invitedByUserId String?    @db.Uuid
  invitedAt       DateTime?
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  devices      Device[]
  sessions     RefreshSession[]
  document     SyncDocument?
  revisions    SyncRevision[]
  mutations    SyncMutation[]
  tokens       AccountToken[]
  recoveryCodes RecoveryCode[]
  auditActor   AuditLog[] @relation("AuditActor")
  auditTarget  AuditLog[] @relation("AuditTarget")

  @@index([status])
  @@index([role, status])
}

model AccountToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
  @@index([codeHash])
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  platform   String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions RefreshSession[]

  @@unique([userId, name])
  @@index([userId])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String?   @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  rotatedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  ip         String?
  userAgent  String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, familyId])
}

model SyncDocument {
  userId            String   @id @db.Uuid
  version           BigInt   @default(0)
  schemaVersion     Int
  document          Json
  checksum          String
  sizeBytes         Int
  updatedAt         DateTime @updatedAt
  updatedByDeviceId String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncRevision {
  userId        String   @db.Uuid
  version       BigInt
  schemaVersion Int
  document      Json
  checksum      String
  deviceId      String?  @db.Uuid
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, version])
  @@index([userId, createdAt])
}

model SyncMutation {
  userId      String   @db.Uuid
  key         String
  requestHash String
  version     BigInt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  targetId   String?  @db.Uuid
  action     String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}
