{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-native",
      "jest"
    ]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src",
    "app.config.ts"
  ]
}
